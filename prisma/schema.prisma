  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User            @relation("ImportJobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  source    ImportSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  items     ImportJobItem[]

  @@index([status, createdAt(sort: Desc)])
  @@index([createdById])
  @@index([sourceId])
  @@map("import_jobs")
}

model ImportJobItem {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId             String              @map("job_id") @db.Uuid
  sourceId          String?             @map("source_id") @db.Uuid
  sourceUrl         String              @map("source_url")
  normalizedUrl     String              @map("normalized_url")
  idempotencyKey    String              @map("idempotency_key")
  status            ImportJobItemStatus @default(queued)
  processingStage   String?             @map("processing_stage")
  attempts          Int                 @default(0)
  maxAttempts       Int                 @default(3) @map("max_attempts")
  leaseExpiresAt    DateTime?           @map("lease_expires_at") @db.Timestamptz(6)
  workerId          String?             @map("worker_id")
  lastError         String?             @map("last_error")
  extractionId      String?             @map("extraction_id") @db.Uuid
  duplicateOfItemId String?             @map("duplicate_of_item_id") @db.Uuid
  recipeId          String?             @map("recipe_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  job             ImportJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source          ImportSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  extraction      RecipeExtraction?  @relation("ItemPrimaryExtraction", fields: [extractionId], references: [id], onDelete: SetNull)
  extractions     RecipeExtraction[] @relation("ExtractionJobItem")
  duplicateOfItem ImportJobItem?     @relation("ImportItemDuplicate", fields: [duplicateOfItemId], references: [id], onDelete: SetNull)
  duplicates      ImportJobItem[]    @relation("ImportItemDuplicate")
  recipe          Recipe?            @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@unique([jobId, idempotencyKey])
  @@index([jobId, status])
  @@index([status, leaseExpiresAt])
  @@index([sourceId])
  @@index([recipeId])
  @@map("import_job_items")
}

model RecipeExtraction {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobItemId        String?  @map("job_item_id") @db.Uuid
  sourceUrl        String   @map("source_url")
  canonicalUrl     String?  @map("canonical_url")
  contentHash      String   @map("content_hash")
  tiersUsed        Json?    @map("tiers_used") @db.JsonB
  extractorVersion String   @map("extractor_version")
  rawExtraction    Json     @map("raw_extraction") @db.JsonB
  rawContentRef    String?  @map("raw_content_ref")
  httpStatus       Int?     @map("http_status")
  warnings         Json?    @db.JsonB
  extractedAt      DateTime @map("extracted_at") @db.Timestamptz(6)

  jobItem           ImportJobItem?           @relation("ExtractionJobItem", fields: [jobItemId], references: [id], onDelete: SetNull)
  items             ImportJobItem[]          @relation("ItemPrimaryExtraction")
  translationDrafts RecipeTranslationDraft[]

  duplicateCandidatesAsSource   DuplicateCandidate[] @relation("DuplicateSourceExtraction")
  duplicateCandidatesAsCompared DuplicateCandidate[] @relation("DuplicateComparedExtraction")

  @@unique([contentHash])
  @@index([jobItemId])
  @@index([sourceUrl])
  @@index([extractedAt])
  @@map("recipe_extractions")
}

model RecipeTranslationDraft {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  extractionId       String            @map("extraction_id") @db.Uuid
  locale             String            @default("vi")
  originalContent    Json              @map("original_content") @db.JsonB
  localizedContent   Json              @map("localized_content") @db.JsonB
  translationStatus  TranslationStatus @default(pending) @map("translation_status")
  translationVersion Int               @default(1) @map("translation_version")
  aiMetadata         Json?             @map("ai_metadata") @db.JsonB
  validationResult   Json?             @map("validation_result") @db.JsonB
  humanReviewStatus  HumanReviewStatus @default(not_reviewed) @map("human_review_status")
  reviewedById       String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt         DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  extraction RecipeExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  reviewedBy User?            @relation("TranslationDraftReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([extractionId, locale])
  @@index([translationStatus])
  @@index([humanReviewStatus])
  @@map("recipe_translation_drafts")
}

model DuplicateCandidate {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  extractionId         String                  @map("extraction_id") @db.Uuid
  comparedRecipeId     String?                 @map("compared_recipe_id") @db.Uuid
  comparedExtractionId String?                 @map("compared_extraction_id") @db.Uuid
  classification       DuplicateClassification
  scores               Json                    @db.JsonB
  status               DuplicateStatus         @default(open)
  resolvedById         String?                 @map("resolved_by_id") @db.Uuid
  resolvedAt           DateTime?               @map("resolved_at") @db.Timestamptz(6)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  extraction         RecipeExtraction  @relation("DuplicateSourceExtraction", fields: [extractionId], references: [id], onDelete: Cascade)
  comparedRecipe     Recipe?           @relation(fields: [comparedRecipeId], references: [id], onDelete: SetNull)
  comparedExtraction RecipeExtraction? @relation("DuplicateComparedExtraction", fields: [comparedExtractionId], references: [id], onDelete: SetNull)
  resolvedBy         User?             @relation("DuplicateCandidateResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([extractionId, comparedRecipeId, comparedExtractionId])
  @@index([classification, status])
  @@index([comparedRecipeId])
  @@map("duplicate_candidates")
}
