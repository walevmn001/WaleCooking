// =============================================================================
// WALE COOKING — Prisma schema
// Nguồn thiết kế: docs/P02/DATABASE_SCHEMA.md + ENTITY_RELATIONSHIP_DIAGRAM.md
//   - UUID PK (gen_random_uuid), timestamptz UTC, snake_case (@@map/@map)
//   - FK RESTRICT mặc định; CASCADE chỉ cho dữ liệu con thuộc sở hữu
//   - Numeric cho định lượng; JSONB chỉ cho audit/snapshot/settings
//   - Extensions: citext (email), pg_trgm + unaccent (tìm kiếm không dấu)
// Không tự ý đổi cấu trúc P02. Sai lệch (nếu có) ghi ở docs/P06/DATABASE_IMPLEMENTATION.md §ADR.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext, pgTrgm(map: "pg_trgm"), unaccent]
}

// =============================================================================
// ENUMS
// =============================================================================

enum AppRole {
  user
  editor
  admin

  @@map("app_role")
}

enum RecipeStatus {
  draft
  in_review
  published
  archived

  @@map("recipe_status")
}

enum Difficulty {
  easy
  medium
  hard

  @@map("difficulty")
}

enum VerificationStatus {
  untested
  tested
  verified

  @@map("verification")
}

enum MeasurementSystem {
  metric
  imperial

  @@map("measurement_system")
}

enum UnitDimension {
  mass
  volume
  count
  custom

  @@map("unit_dimension")
}

enum QuantityType {
  decimal
  fraction
  range
  text

  @@map("quantity_type")
}

enum IngredientAliasKind {
  synonym
  local
  search

  @@map("ingredient_alias_kind")
}

enum SubstitutionQuality {
  exact
  good
  approximate

  @@map("substitution_quality")
}

enum AllergenPresence {
  contains
  may_contain
  free

  @@map("allergen_presence")
}

enum DensityConfidence {
  high
  medium
  low

  @@map("density_confidence")
}

enum CookingSessionStatus {
  active
  paused
  completed
  abandoned

  @@map("cooking_session_status")
}

enum MealType {
  breakfast
  lunch
  dinner
  snack

  @@map("meal_type")
}

enum ShoppingListStatus {
  active
  completed

  @@map("shopping_list_status")
}

enum NutritionBasis {
  per_serving
  per_100g
  total

  @@map("nutrition_basis")
}

enum NutritionDataSourceType {
  measured
  calculated
  estimated
  unknown

  @@map("nutrition_data_source_type")
}

enum AllergenSource {
  derived
  declared

  @@map("allergen_source")
}

enum SourceVerifiedStatus {
  unverified
  verified
  rejected

  @@map("source_verified_status")
}

enum ReviewDecision {
  approved
  rejected
  changes_requested

  @@map("review_decision")
}

enum ContentReviewAction {
  submit
  approve
  request_changes
  publish
  archive

  @@map("content_review_action")
}

enum MediaStatus {
  active
  archived

  @@map("media_status")
}

enum RecipeImageRole {
  hero
  step
  gallery

  @@map("recipe_image_role")
}

// --- Recipe Importer (P16.7 / I1) -------------------------------------------

enum ImportSourceStatus {
  disabled
  url_import_only
  auto_enabled
  paused_blocked
  manual_only
  disallowed

  @@map("import_source_status")
}

enum ContentReusePolicy {
  facts_only
  rewrite_required
  licensed_reuse
  manual_only

  @@map("content_reuse_policy")
}

enum ImageReusePolicy {
  do_not_copy
  allowed_with_license
  manual_review

  @@map("image_reuse_policy")
}

enum ImportSourceLastStatus {
  ok
  blocked
  rate_limited
  parse_failed
  unknown

  @@map("import_source_last_status")
}

enum ImportJobMode {
  url_import
  auto_discovery

  @@map("import_job_mode")
}

enum ImportJobStatus {
  created
  running
  paused
  cancelled
  partial
  done

  @@map("import_job_status")
}

enum ImportJobItemStatus {
  discovered
  queued
  processing
  needs_review
  duplicate
  failed
  approved
  rejected
  published

  @@map("import_job_item_status")
}

enum TranslationStatus {
  pending
  in_progress
  done
  failed
  needs_human

  @@map("translation_status")
}

enum HumanReviewStatus {
  not_reviewed
  in_review
  approved
  rejected

  @@map("human_review_status")
}

enum DuplicateClassification {
  exact
  likely
  similar
  different

  @@map("duplicate_classification")
}

enum DuplicateStatus {
  open
  merged
  dismissed

  @@map("duplicate_status")
}

// =============================================================================
// 5.1 IDENTITY & USER (tương thích Auth.js Prisma Adapter)
// =============================================================================

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String?
  email           String?   @unique @db.Citext
  emailVerified   DateTime? @map("email_verified") @db.Timestamptz(6)
  image           String?
  // P18 (B-P06-02): băm mật khẩu cho đăng nhập Credentials (chỉ tài khoản quản trị).
  // NULL = tài khoản không có mật khẩu (không thể đăng nhập bằng Credentials).
  // KHÔNG lưu mật khẩu thô; chỉ lưu chuỗi băm scrypt có salt (xem lib/auth/password.ts).
  passwordHash    String?   @map("password_hash")
  role            AppRole   @default(user)
  preferredLocale String    @default("vi") @map("preferred_locale")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts           Account[]
  sessions           Session[]
  profile            UserProfile?
  preferences        UserPreference?
  dietaryPreferences UserDietaryPreference[]
  allergens          UserAllergen[]
  authoredRecipes    Recipe[]                @relation("RecipeAuthor")
  editedRecipes      Recipe[]                @relation("RecipeEditor")
  recipeVersions     RecipeVersion[]
  collections        Collection[]
  collectionRecipes  CollectionRecipe[]      @relation("CollectionRecipeAddedBy")
  notes              RecipeNote[]
  cookedHistory      CookedHistory[]
  cookingSessions    CookingSession[]
  favorites          Favorite[]
  mealPlans          MealPlan[]
  shoppingLists      ShoppingList[]
  uploadedMedia      MediaAsset[]            @relation("MediaCreatedBy")
  verifiedSources    ContentSource[]         @relation("SourceVerifiedBy")
  reviewRecords      ContentReviewRecord[]
  contentReviews     ContentReview[]
  auditLogs          AuditLog[]

  importJobsCreated           ImportJob[]              @relation("ImportJobCreatedBy")
  translationDraftsReviewed   RecipeTranslationDraft[] @relation("TranslationDraftReviewedBy")
  duplicateCandidatesResolved DuplicateCandidate[]     @relation("DuplicateCandidateResolvedBy")

  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@id([identifier, token])
  @@map("verification_tokens")
}

// =============================================================================
// 5.1b USER PROFILE & PREFERENCES
// =============================================================================

model UserProfile {
  userId        String   @id @map("user_id") @db.Uuid
  displayName   String?  @map("display_name")
  bio           String?
  avatarMediaId String?  @map("avatar_media_id") @db.Uuid
  locale        String   @default("vi")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarMedia MediaAsset? @relation("ProfileAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@map("user_profiles")
}

model UserPreference {
  userId            String            @id @map("user_id") @db.Uuid
  preferredLocale   String            @default("vi") @map("preferred_locale")
  measurementSystem MeasurementSystem @default(metric) @map("measurement_system")
  defaultServings   Int?              @map("default_servings")
  reducedMotion     Boolean           @default(false) @map("reduced_motion")
  settings          Json?             @db.JsonB
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserDietaryPreference {
  userId         String @map("user_id") @db.Uuid
  taxonomyTermId String @map("taxonomy_term_id") @db.Uuid

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  term TaxonomyTerm @relation("DietaryPreferenceTerm", fields: [taxonomyTermId], references: [id], onDelete: Restrict)

  @@id([userId, taxonomyTermId])
  @@index([taxonomyTermId])
  @@map("user_dietary_preferences")
}

model UserAllergen {
  userId         String @map("user_id") @db.Uuid
  allergenTermId String @map("allergen_term_id") @db.Uuid

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  term TaxonomyTerm @relation("UserAllergenTerm", fields: [allergenTermId], references: [id], onDelete: Restrict)

  @@id([userId, allergenTermId])
  @@index([allergenTermId])
  @@map("user_allergens")
}

// =============================================================================
// 5.4 TAXONOMY
// =============================================================================

model TaxonomyType {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String  @unique
  isHierarchical Boolean @default(false) @map("is_hierarchical")
  isMultiSelect  Boolean @default(false) @map("is_multi_select")
  isRequired     Boolean @default(false) @map("is_required")
  isActive       Boolean @default(true) @map("is_active")
  sortOrder      Int     @default(0) @map("sort_order")

  terms TaxonomyTerm[]

  @@map("taxonomy_types")
}

model TaxonomyTerm {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxonomyTypeId String  @map("taxonomy_type_id") @db.Uuid
  parentId       String? @map("parent_id") @db.Uuid
  slug           String
  icon           String?
  isActive       Boolean @default(true) @map("is_active")
  sortOrder      Int     @default(0) @map("sort_order")

  type         TaxonomyType              @relation(fields: [taxonomyTypeId], references: [id], onDelete: Restrict)
  parent       TaxonomyTerm?             @relation("TaxonomyParent", fields: [parentId], references: [id], onDelete: SetNull)
  children     TaxonomyTerm[]            @relation("TaxonomyParent")
  translations TaxonomyTermTranslation[]
  aliases      TaxonomyTermAlias[]

  ingredients         Ingredient[]            @relation("IngredientCategory")
  recipesFoodType     Recipe[]                @relation("RecipeFoodType")
  recipesCuisine      Recipe[]                @relation("RecipeCuisine")
  recipeTaxonomy      RecipeTaxonomyTerm[]
  recipeAllergens     RecipeAllergen[]
  ingredientAllergens IngredientAllergen[]    @relation("IngredientAllergenTerm")
  userDietaryPrefs    UserDietaryPreference[] @relation("DietaryPreferenceTerm")
  userAllergens       UserAllergen[]          @relation("UserAllergenTerm")

  @@unique([taxonomyTypeId, slug])
  @@index([taxonomyTypeId])
  @@index([parentId])
  @@map("taxonomy_terms")
}

model TaxonomyTermTranslation {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  termId      String  @map("term_id") @db.Uuid
  locale      String
  name        String
  description String?

  term TaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([termId, locale])
  @@map("taxonomy_term_translations")
}

model TaxonomyTermAlias {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  termId String  @map("term_id") @db.Uuid
  alias  String
  locale String?

  term TaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([termId, alias, locale])
  @@map("taxonomy_term_aliases")
}

// =============================================================================
// 7.1 UNITS
// =============================================================================

model Unit {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String        @unique
  dimension UnitDimension
  isBase    Boolean       @default(false) @map("is_base")
  sortOrder Int           @default(0) @map("sort_order")

  translations        UnitTranslation[]
  conversionsFrom     UnitConversion[]    @relation("UnitConversionFrom")
  conversionsTo       UnitConversion[]    @relation("UnitConversionTo")
  ingredientDefaults  Ingredient[]        @relation("IngredientDefaultUnit")
  ingredientDensities IngredientDensity[] @relation("DensityVolumeUnit")
  ingredientUnits     IngredientUnit[]
  recipeIngredients   RecipeIngredient[]
  shoppingListItems   ShoppingListItem[]

  @@map("units")
}

model UnitTranslation {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId String  @map("unit_id") @db.Uuid
  locale String
  name   String
  symbol String?

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, locale])
  @@map("unit_translations")
}

model UnitConversion {
  fromUnitId String  @map("from_unit_id") @db.Uuid
  toUnitId   String  @map("to_unit_id") @db.Uuid
  factor     Decimal @db.Decimal(18, 10)

  fromUnit Unit @relation("UnitConversionFrom", fields: [fromUnitId], references: [id], onDelete: Restrict)
  toUnit   Unit @relation("UnitConversionTo", fields: [toUnitId], references: [id], onDelete: Restrict)

  @@id([fromUnitId, toUnitId])
  @@index([toUnitId])
  @@map("unit_conversions")
}

// =============================================================================
// 5.3 INGREDIENT
// =============================================================================

model Ingredient {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String   @unique
  originalName   String?  @map("original_name")
  categoryTermId String?  @map("category_term_id") @db.Uuid
  defaultUnitId  String?  @map("default_unit_id") @db.Uuid
  isCommon       Boolean  @default(false) @map("is_common")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category    TaxonomyTerm? @relation("IngredientCategory", fields: [categoryTermId], references: [id], onDelete: Restrict)
  defaultUnit Unit?         @relation("IngredientDefaultUnit", fields: [defaultUnitId], references: [id], onDelete: SetNull)

  translations                IngredientTranslation[]
  aliases                     IngredientAlias[]
  substitutionsAs             IngredientSubstitution[]     @relation("SubstitutionIngredient")
  substitutionsTo             IngredientSubstitution[]     @relation("SubstitutionSubstitute")
  allergens                   IngredientAllergen[]
  densities                   IngredientDensity[]
  units                       IngredientUnit[]
  recipeIngredients           RecipeIngredient[]
  recipeIngredientSubstitutes RecipeIngredientSubstitute[] @relation("IngredientSubstituteOption")
  shoppingListItems           ShoppingListItem[]

  @@index([categoryTermId])
  @@index([defaultUnitId])
  @@map("ingredients")
}

model IngredientTranslation {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  locale       String
  name         String
  notes        String?

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, locale])
  @@map("ingredient_translations")
}

model IngredientAlias {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ingredientId String              @map("ingredient_id") @db.Uuid
  alias        String
  locale       String?
  kind         IngredientAliasKind

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, alias, locale])
  @@map("ingredient_aliases")
}

model IngredientSubstitution {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ingredientId String              @map("ingredient_id") @db.Uuid
  substituteId String              @map("substitute_id") @db.Uuid
  quality      SubstitutionQuality
  ratioNumeric Decimal?            @map("ratio_numeric") @db.Decimal(8, 4)
  ratioNote    String?             @map("ratio_note")
  note         String?

  ingredient Ingredient @relation("SubstitutionIngredient", fields: [ingredientId], references: [id], onDelete: Restrict)
  substitute Ingredient @relation("SubstitutionSubstitute", fields: [substituteId], references: [id], onDelete: Restrict)

  @@unique([ingredientId, substituteId])
  @@index([substituteId])
  @@map("ingredient_substitutions")
}

model IngredientAllergen {
  ingredientId   String           @map("ingredient_id") @db.Uuid
  allergenTermId String           @map("allergen_term_id") @db.Uuid
  presence       AllergenPresence

  ingredient Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  term       TaxonomyTerm @relation("IngredientAllergenTerm", fields: [allergenTermId], references: [id], onDelete: Restrict)

  @@id([ingredientId, allergenTermId])
  @@index([allergenTermId])
  @@map("ingredient_allergens")
}

model IngredientDensity {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ingredientId String            @map("ingredient_id") @db.Uuid
  volumeUnitId String            @map("volume_unit_id") @db.Uuid
  gramsPerUnit Decimal           @map("grams_per_unit") @db.Decimal(10, 4)
  source       String?
  confidence   DensityConfidence

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  volumeUnit Unit       @relation("DensityVolumeUnit", fields: [volumeUnitId], references: [id], onDelete: Restrict)

  @@unique([ingredientId, volumeUnitId])
  @@index([volumeUnitId])
  @@map("ingredient_densities")
}

model IngredientUnit {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  unitId       String   @map("unit_id") @db.Uuid
  gramsPerUnit Decimal? @map("grams_per_unit") @db.Decimal(10, 4)
  isDefault    Boolean  @default(false) @map("is_default")

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([ingredientId, unitId])
  @@index([unitId])
  @@map("ingredient_units")
}

// =============================================================================
// 5.9 MEDIA (thực thể độc lập, file không nằm trong Postgres)
// =============================================================================

model MediaAsset {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey     String      @unique @map("storage_key")
  publicUrl      String?     @map("public_url")
  mimeType       String      @map("mime_type")
  sizeBytes      Int         @map("size_bytes")
  width          Int?
  height         Int?
  checksum       String?
  altTextDefault String?     @map("alt_text_default")
  status         MediaStatus @default(active)
  createdById    String?     @map("created_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy      User?         @relation("MediaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  recipeImages   RecipeImage[]
  primaryImageOf Recipe[]      @relation("RecipePrimaryImage")
  profileAvatars UserProfile[] @relation("ProfileAvatar")

  @@index([createdById])
  @@map("media_assets")
}

// =============================================================================
// 5.2 RECIPE
// =============================================================================

model Recipe {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String             @unique
  status             RecipeStatus       @default(draft)
  authorId           String             @map("author_id") @db.Uuid
  editorId           String?            @map("editor_id") @db.Uuid
  foodTypeTermId     String?            @map("food_type_term_id") @db.Uuid
  cuisineTermId      String?            @map("cuisine_term_id") @db.Uuid
  difficulty         Difficulty         @default(easy)
  prepMinutes        Int?               @map("prep_minutes")
  cookMinutes        Int?               @map("cook_minutes")
  totalMinutes       Int?               @map("total_minutes")
  baseServings       Decimal            @map("base_servings") @db.Decimal(6, 2)
  verificationStatus VerificationStatus @default(untested) @map("verification_status")
  defaultLocale      String             @default("vi") @map("default_locale")
  primaryImageId     String?            @map("primary_image_id") @db.Uuid
  publishedAt        DateTime?          @map("published_at") @db.Timestamptz(6)
  archivedAt         DateTime?          @map("archived_at") @db.Timestamptz(6)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  author       User          @relation("RecipeAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  editor       User?         @relation("RecipeEditor", fields: [editorId], references: [id], onDelete: SetNull)
  foodTypeTerm TaxonomyTerm? @relation("RecipeFoodType", fields: [foodTypeTermId], references: [id], onDelete: Restrict)
  cuisineTerm  TaxonomyTerm? @relation("RecipeCuisine", fields: [cuisineTermId], references: [id], onDelete: Restrict)
  primaryImage MediaAsset?   @relation("RecipePrimaryImage", fields: [primaryImageId], references: [id], onDelete: SetNull)

  translations      RecipeTranslation[]
  steps             RecipeStep[]
  images            RecipeImage[]
  ingredients       RecipeIngredient[]
  equipmentLinks    RecipeEquipment[]
  taxonomyTerms     RecipeTaxonomyTerm[]
  sources           RecipeSource[]
  versions          RecipeVersion[]
  slugRedirects     RecipeSlugRedirect[]
  nutrition         RecipeNutrition[]
  allergens         RecipeAllergen[]
  favorites         Favorite[]
  collectionRecipes CollectionRecipe[]
  notes             RecipeNote[]
  cookedHistory     CookedHistory[]
  cookingSessions   CookingSession[]
  mealPlanItems     MealPlanItem[]
  contentReviews    ContentReview[]
  attributions      SourceAttribution[]

  importItems         ImportJobItem[]
  duplicateCandidates DuplicateCandidate[]

  @@index([status])
  @@index([cuisineTermId])
  @@index([foodTypeTermId])
  @@index([status, publishedAt(sort: Desc)])
  @@index([totalMinutes])
  @@index([difficulty])
  @@index([authorId])
  @@index([editorId])
  @@index([primaryImageId])
  @@map("recipes")
}

model RecipeTranslation {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId       String  @map("recipe_id") @db.Uuid
  locale         String
  title          String
  summary        String?
  description    String?
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")

