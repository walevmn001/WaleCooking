# =============================================================================
# WALE COOKING — biến môi trường (MẪU — sao chép sang `.env` rồi điền giá trị thật)
# KHÔNG commit file `.env` thật. KHÔNG điền bí mật thật vào file này.
# =============================================================================

# --- Cơ sở dữ liệu (Neon PostgreSQL) -----------------------------------------
# DATABASE_URL  : kết nối POOLED (PgBouncer) — dùng cho RUNTIME (Next.js server).
#                 Thêm `?pgbouncer=true` khi dùng pooler của Neon.
# DIRECT_URL    : kết nối DIRECT (không pool) — dùng cho MIGRATION/seed (`prisma migrate`).
# Với PostgreSQL local (phát triển) cả hai có thể trỏ cùng một URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- CSDL cho kiểm thử (tùy chọn) --------------------------------------------
# Nếu không đặt, test dùng mặc định local: postgresql://wale:wale@127.0.0.1:5432/wale_test
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/TEST_DATABASE"

# --- Auth.js (P18) -----------------------------------------------------------
# Đăng nhập QUẢN TRỊ bằng Credentials provider (email + mật khẩu), session JWT.
# AUTH_SECRET  : BẮT BUỘC ở runtime. Sinh bằng `npx auth secret` hoặc
#                `openssl rand -base64 32`. KHÔNG commit giá trị thật.
# AUTH_URL     : URL công khai của ứng dụng (vd http://localhost:3000 khi chạy local,
#                https://<domain> khi triển khai). Có thể bỏ trống nếu suy ra được từ host.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Tài khoản quản trị đầu tiên: KHÔNG có tài khoản/mật khẩu mặc định.
# Provisioning bằng lệnh (biến chỉ đặt trong lệnh chạy, KHÔNG ghi vào Git):
#   DATABASE_URL="…" ADMIN_EMAIL="admin@example.com" ADMIN_PASSWORD="$(openssl rand -base64 18)" \
#   ADMIN_ROLE=admin pnpm admin:create

# --- Cloudflare R2 (lưu trữ media) -------------------------------------------
# Để trống khi chưa có tài khoản R2 → adapter tự chuyển sang local provider (chỉ dev/test).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
# Nếu đặt (dev/test): dùng local storage adapter, ghi tệp vào thư mục này.
MEDIA_LOCAL_DIR=".media-local"
